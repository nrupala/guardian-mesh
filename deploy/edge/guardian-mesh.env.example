# Guardian Mesh edge profile (WO-18 profile 2 / DP-6) - environment example.
#
# Copy to /etc/guardian-mesh/guardian-mesh.env (systemd form) and edit. This is
# the operator's single place for runtime settings; the resource ceilings stay
# in the systemd unit / compose file, not here. Only real GUARDIAN_MESH_*
# variables read by guardian-meshd/src/config.rs are listed.

# Workspace directory: signing key, policy, sessions, revocation registry and
# the hash-chained audit log. Keep it on persistent local storage.
GUARDIAN_MESH_WORKSPACE=/var/lib/guardian-mesh/workspace

# Output directory for per-project evaluation artifacts.
GUARDIAN_MESH_OUTPUT=/var/lib/guardian-mesh/output

# Listener address. LOOPBACK is the edge default: the guardian serves its local
# workload. 0.0.0.0 is an operator choice for a multi-interface gateway, never
# the default.
GUARDIAN_MESH_BIND_ADDR=127.0.0.1

# Listener port.
GUARDIAN_MESH_PORT=50051

# GUARDIAN_MESH_HANDSHAKE_SECRET
#   Deliberately carries NO value in this file, not even a placeholder. Inject
#   the handshake secret at deploy time (for example from your secret manager
#   into a root-owned, mode 0600 environment file or the process environment).
#   If it is unset the daemon falls back to its built-in development default;
#   never rely on that on an edge endpoint. Never commit a real secret.

# Node identity reported by Health and recorded in proofs. When empty the
# daemon derives node-<first 12 hex of the signing-key fingerprint>.
GUARDIAN_MESH_NODE_ID=

# Default policy/firewall rate limit.
GUARDIAN_MESH_POLICY_THROTTLE_RATE=100

# Comma-separated action types that require escalation.
GUARDIAN_MESH_POLICY_ESCALATE_ACTIONS=

# Directory of administrator keys for policy changes; leave unset if unused.
# GUARDIAN_MESH_POLICY_ADMIN_KEYS_DIR=/etc/guardian-mesh/policy-admin-keys

# DC-14 revocation propagation bound in seconds (0 falls back to 60).
GUARDIAN_MESH_REVOCATION_BOUND_SECS=60

# Comma-separated SPIFFE trust domains accepted at handshake.
GUARDIAN_MESH_SPIFFE_TRUST_DOMAINS=

# Require SPIFFE SVID attestation at handshake (1/true).
GUARDIAN_MESH_REQUIRE_SPIFFE=false

# Directory of OpenPGP administrator keys; leave unset if unused.
# GUARDIAN_MESH_PGP_ADMIN_KEYS_DIR=/etc/guardian-mesh/pgp-admin-keys

# Comma-separated tenant ids to register; the default tenant is always present.
GUARDIAN_MESH_TENANTS=

# Per-tenant rate budget per window. Defaults to the policy throttle rate.
GUARDIAN_MESH_TENANT_RATE_BUDGET=100

# Tenant budget sliding window in milliseconds (positive values only).
GUARDIAN_MESH_TENANT_BUDGET_WINDOW_MS=1000

# Start in declared degraded mode (1/true) with a fail-closed safe subset.
GUARDIAN_MESH_DEGRADED=false

# Comma-separated action types still allowed while degraded.
GUARDIAN_MESH_DEGRADED_SAFE_ACTIONS=
